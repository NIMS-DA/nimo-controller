<?xml version="1.0" encoding="UTF-8"?>
<nimo-workflow version="0.0.4">
  <servers>
    <server name="phase">
      <tool name="get_phase" params="{temperature: float, pressure: float}"/>
    </server>
  </servers>
  <candidates>
    <parameter name="temperature"/>
    <parameter name="pressure"/>
    <objective name="objective"/>
  </candidates>
  <workflow>
    <repeat counter="i" times="20">
      <if counter="i" op="&lt;" value="10">
        <then><nimo tool="selection" method="RE"/></then>
        <else><nimo tool="selection" method="PDC"/></else>
      </if>
      <nimo tool="update">
        <call server="phase" tool="get_phase" temperature="proposal.temperature" pressure="proposal.pressure"/>
      </nimo>
    </repeat>
    <nimo tool="plot_phase_diagram"/>
  </workflow>
</nimo-workflow>