<?xml version="1.0" encoding="UTF-8"?>
<nimo-workflow version="0.1.0">
  <servers>
    <server name="ackley"/>
  </servers>
  <candidates>
    <parameter name="x1"/>
    <parameter name="x2"/>
    <objective name="objective"/>
  </candidates>
  <workflow>
    <repeat counter="i" times="10">
      <if counter="i" op="&lt;" value="5">
        <then><nimo tool="selection" method="RE"/></then>
        <else><nimo tool="selection" method="PHYSBO" minimization="true"/></else>
      </if>
      <nimo tool="update">
        <call server="ackley" tool="ackley_function" x1="proposal.x1" x2="proposal.x2"/>
      </nimo>
    </repeat>
    <nimo tool="plot_history_best" minimization="true"/>
  </workflow>
</nimo-workflow>