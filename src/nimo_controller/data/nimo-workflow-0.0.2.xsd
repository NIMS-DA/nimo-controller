<?xml version="1.0" encoding="UTF-8"?>
<!--
  Schema for the NIMO Controller workflow log XML (format version 0.0.2).
  Reference/specification only — the app does not load this at runtime.

  Root <nimo-workflow> has three sections:
    <servers>     the MCP servers this run was connected to, with versions
    <candidates>  the candidates snapshot this run started from (file name +
                  SHA-256), plus its parameter and objective columns
    <workflow>    the procedure: a sequence of statement blocks

  Changes from 0.0.1:
    - <candidates> gained the optional "snapshot" attribute. It names the copy
      of candidates.csv taken when the run started; "sha256" is the hash of
      that same file. Both are omitted together when no snapshot is known.
    - <variable> was renamed to <parameter>, and <objective> was added, so the
      candidates columns are spelled out rather than only the proposal inputs.
    - <servers> no longer lists NIMO. It runs in-process as direct Python
      calls, so it is not a server that was connected to. NIMO tools still
      appear in the procedure as server="nimo".
    - <server> lost its @type attribute: with NIMO gone every entry is an MCP
      server, so the distinction it drew no longer exists.

  Note: <tool> argument attributes are open (xs:anyAttribute). Their values may be
  literals or references written as "proposal.<var>" / "counter.<var>"; that
  convention is enforced by the serializer, not by this schema.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

  <!-- ===== Root ===== -->
  <xs:element name="nimo-workflow">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="servers"/>
        <xs:element ref="candidates"/>
        <xs:element ref="workflow"/>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- ===== Servers ===== -->
  <xs:element name="servers">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="server" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="server">
    <xs:complexType>
      <xs:attribute name="name" type="xs:string" use="required"/>
      <xs:attribute name="url" type="xs:anyURI" use="optional"/>
      <xs:attribute name="version" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!-- ===== Candidates ===== -->
  <xs:element name="candidates">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="parameter" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element ref="objective" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="snapshot" type="xs:string" use="optional"/>
      <xs:attribute name="sha256" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="parameter">
    <xs:complexType>
      <xs:attribute name="name" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="objective">
    <xs:complexType>
      <xs:attribute name="name" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- ===== Workflow (procedure) ===== -->
  <xs:element name="workflow">
    <xs:complexType>
      <xs:group ref="blocks"/>
    </xs:complexType>
  </xs:element>

  <!-- A sequence of statement blocks.
       The occurrence constraints sit on the inner choice, not on the group's
       own particle, where XSD forbids them (0.0.1 had them in the wrong place,
       which made that schema fail to load at all). -->
  <xs:group name="blocks">
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="tool"/>
        <xs:element ref="repeat"/>
        <xs:element ref="if"/>
        <xs:element ref="update"/>
      </xs:choice>
    </xs:sequence>
  </xs:group>

  <!-- ===== tool: server/name required, plus arbitrary argument attributes ===== -->
  <xs:element name="tool">
    <xs:complexType>
      <xs:attribute name="server" type="xs:string" use="required"/>
      <xs:attribute name="name" type="xs:string" use="required"/>
      <xs:anyAttribute processContents="skip"/>
    </xs:complexType>
  </xs:element>

  <!-- ===== repeat ===== -->
  <xs:element name="repeat">
    <xs:complexType>
      <xs:group ref="blocks"/>
      <xs:attribute name="counter" type="xs:string" use="optional"/>
      <xs:attribute name="times" type="xs:nonNegativeInteger" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- ===== if / then / else ===== -->
  <xs:element name="if">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="then"/>
        <xs:element ref="else" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="counter" type="xs:string" use="required"/>
      <xs:attribute name="op" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="=="/>
            <xs:enumeration value="&lt;"/>
            <xs:enumeration value="&gt;"/>
            <xs:enumeration value="&lt;="/>
            <xs:enumeration value="&gt;="/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="value" type="xs:integer" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="then">
    <xs:complexType><xs:group ref="blocks"/></xs:complexType>
  </xs:element>
  <xs:element name="else">
    <xs:complexType><xs:group ref="blocks"/></xs:complexType>
  </xs:element>

  <!-- ===== update: contains exactly one tool ===== -->
  <xs:element name="update">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="tool"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
